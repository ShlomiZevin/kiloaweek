rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every user owns only their own tree. The server (Admin SDK) bypasses rules.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
